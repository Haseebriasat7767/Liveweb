# ---------------------------------------------------------------------------
# LUXURY LEAD MACHINE — environment configuration
# Copy to `.env.local` and fill in. Everything has a sensible default.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, Open Graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://luxuryleadmachine.example.com

# Demo mode: shows the "client-closing" demo dock (lead inbox, event stream,
# config inspector) and the fictional-content disclaimer banners.
NEXT_PUBLIC_DEMO_MODE=true

# Analytics provider: none | console | gtm | plausible | segment
NEXT_PUBLIC_ANALYTICS_PROVIDER=console

# Where leads are delivered
LEAD_EMAIL_RECIPIENT=advisor@example.com
LEAD_WEBHOOK_URL=
LEAD_CRM_PROVIDER=none

# Shared secret required by GET /api/leads?admin=1 (leave blank to disable)
LEAD_ADMIN_TOKEN=

# Optional integrations (blank = the UI element is hidden entirely)
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
